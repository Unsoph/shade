# Install: sudo cp deploy/shade.service /etc/systemd/system/ && edit paths/user
#          sudo systemctl daemon-reload && sudo systemctl enable --now shade
# SHADE's own supervisor restarts the engine; systemd restarts the supervisor.
[Unit]
Description=SHADE self-healing edge inference
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=pi
WorkingDirectory=/home/pi/shade
ExecStart=/usr/bin/python3 run.py --headless --skip-setup --supervised --serve
Restart=always
RestartSec=5
WatchdogSec=60
Nice=-5

[Install]
WantedBy=multi-user.target
