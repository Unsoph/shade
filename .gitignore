# SHADE .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environment
venv/
.venv/
env/

# Models (large binary files)
models/*.onnx
models/*.tflite
models/*.engine
models/*.pkl
!models/.gitkeep

# Benchmarks and logs
benchmarks/
logs/
*.log
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker/*.tar

# Temp files
*.tmp
last_known_good.json
